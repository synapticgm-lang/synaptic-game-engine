# Google OAuth (legacy Drive sync helper — optional when using Supabase Auth)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Supabase — required for Google OAuth + Game Ops telemetry + GM proxy
# Map these same keys in the Vercel project Environment Variables for production.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# After deploy: run supabase/migrations/009_player_feedback_entitlements.sql
# and 010_purchase_ledger_staff_notes.sql
# (feedback inbox, entitlements, purchase ledger for tax/comps).

# Production IP protection: force GM turns through supabase/functions/gm-turn
# (prompts assemble server-side; do not ship VITE_* provider API keys).
VITE_REQUIRE_GM_PROXY=true

# Which product surface this build is for (hard content rails + NSFW catalog).
# store = Google Play / Apple (default) — Kid or Adult Store; hosted AI only; no player keys
# web   = website — Kid, Adult Web, or Admin BYOK (Text AI key + Image AI key after disclaimer)
VITE_DISTRIBUTION_CHANNEL=store

# Rewarded ads (Earn turns). Leave unset for local stub (completes without a network).
# When true, Kid Mode expects AdMob kids; adult web expects AppLixir (SDKs not wired yet).
# VITE_REWARDED_ADS_LIVE=true

# --- Server-only secrets (Supabase Edge Function secrets — NEVER prefix with VITE_) ---
# supabase secrets set OPENROUTER_API_KEY=sk-or-v1-...
# supabase secrets set GEMINI_API_KEY=AIza...
# Players may still BYOK via Settings; the edge function prefers clientApiKey when provided.
