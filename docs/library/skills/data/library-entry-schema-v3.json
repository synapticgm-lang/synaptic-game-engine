{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://synapticgm.example/schemas/library-entry-v3.json",
 "title": "SynapticGM Library Entry",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "identity",
  "balance",
  "getting",
  "using",
  "checks",
  "growth",
  "showing",
  "who_uses",
  "paths_and_matching",
  "bookkeeping"
 ],
 "properties": {
  "identity": {
   "$ref": "#/$defs/identity"
  },
  "balance": {
   "$ref": "#/$defs/balance"
  },
  "getting": {
   "$ref": "#/$defs/getting"
  },
  "using": {
   "$ref": "#/$defs/using"
  },
  "checks": {
   "$ref": "#/$defs/checks"
  },
  "growth": {
   "$ref": "#/$defs/growth"
  },
  "showing": {
   "$ref": "#/$defs/showing"
  },
  "who_uses": {
   "$ref": "#/$defs/who_uses"
  },
  "paths_and_matching": {
   "$ref": "#/$defs/paths_and_matching"
  },
  "bookkeeping": {
   "$ref": "#/$defs/bookkeeping"
  }
 },
 "allOf": [
  {
   "if": {
    "required": [
     "identity"
    ],
    "properties": {
     "identity": {
      "required": [
       "kind"
      ],
      "properties": {
       "kind": {
        "enum": [
         "trait",
         "perk_or_feat",
         "title",
         "class_feature",
         "flaw",
         "condition",
         "resource",
         "power"
        ]
       }
      }
     }
    }
   },
   "then": {
    "properties": {
     "checks": {
      "properties": {
       "untrained": {
        "not": {
         "required": [
          "OPEN"
         ]
        }
       }
      }
     },
     "bookkeeping": {
      "properties": {
       "open_decisions": {
        "not": {
         "contains": {
          "const": "untrained_gates"
         }
        }
       }
      }
     }
    }
   }
  }
 ],
 "$defs": {
  "text": {
   "type": "string",
   "minLength": 1
  },
  "writer_text": {
   "type": "string",
   "minLength": 1,
   "pattern": "^[^0-9]*$",
   "description": "Writer-facing. No digits allowed."
  },
  "na": {
   "const": "not applicable"
  },
  "text_list": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/text"
   }
  },
  "text_list_or_na": {
   "anyOf": [
    {
     "$ref": "#/$defs/text_list"
    },
    {
     "$ref": "#/$defs/na"
    }
   ]
  },
  "open_name": {
   "enum": [
    "hidden_thievery_rank",
    "untrained_gates",
    "growth_by_mode",
    "failure_cost_retries",
    "group_stealth",
    "duplicate_skill",
    "system_names_world_skill",
    "save_cross_mode"
   ]
  },
  "open_tag": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "OPEN"
   ],
   "properties": {
    "OPEN": {
     "$ref": "#/$defs/open_name"
    },
    "options": {
     "$ref": "#/$defs/text_list"
    }
   }
  },
  "text_or_open": {
   "anyOf": [
    {
     "$ref": "#/$defs/text"
    },
    {
     "$ref": "#/$defs/open_tag"
    }
   ]
  },
  "element_name": {
   "enum": [
    "fire",
    "water",
    "ice",
    "earth",
    "metal",
    "air",
    "lightning",
    "light",
    "shadow",
    "nature",
    "poison",
    "acid",
    "sound",
    "force",
    "holy",
    "death",
    "psychic",
    "blood",
    "gravity",
    "crystal",
    "magma",
    "steam",
    "mud",
    "sand",
    "ice-fire"
   ]
  },
  "damage_name": {
   "anyOf": [
    {
     "$ref": "#/$defs/element_name"
    },
    {
     "enum": [
      "slashing",
      "piercing",
      "bludgeoning"
     ]
    }
   ]
  },
  "approach_name": {
   "enum": [
    "careful",
    "clever",
    "flashy",
    "forceful",
    "quick",
    "sneaky"
   ]
  },
  "housing_name": {
   "enum": [
    "private_window",
    "worn_device",
    "world_status",
    "leftover_pocket"
   ]
  },
  "five_lines": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "bad_failure",
    "failure",
    "success_at_cost",
    "clean_success",
    "great_success"
   ],
   "properties": {
    "bad_failure": {
     "$ref": "#/$defs/writer_text"
    },
    "failure": {
     "$ref": "#/$defs/writer_text"
    },
    "success_at_cost": {
     "$ref": "#/$defs/writer_text"
    },
    "clean_success": {
     "$ref": "#/$defs/writer_text"
    },
    "great_success": {
     "$ref": "#/$defs/writer_text"
    }
   }
  },
  "five_lines_or_na": {
   "anyOf": [
    {
     "$ref": "#/$defs/five_lines"
    },
    {
     "$ref": "#/$defs/na"
    }
   ]
  },
  "engine_five_lines": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "bad_failure",
    "failure",
    "success_at_cost",
    "clean_success",
    "great_success"
   ],
   "properties": {
    "bad_failure": {
     "$ref": "#/$defs/text"
    },
    "failure": {
     "$ref": "#/$defs/text"
    },
    "success_at_cost": {
     "$ref": "#/$defs/text"
    },
    "clean_success": {
     "$ref": "#/$defs/text"
    },
    "great_success": {
     "$ref": "#/$defs/text"
    }
   }
  },
  "price_pair": {
   "type": "array",
   "minItems": 2,
   "maxItems": 2,
   "prefixItems": [
    {
     "$ref": "#/$defs/text"
    },
    {
     "type": "integer"
    }
   ],
   "items": false
  },
  "credit_pair": {
   "oneOf": [
    {
     "type": "array",
     "minItems": 2,
     "maxItems": 3,
     "prefixItems": [
      {
       "const": "resource small"
      },
      {
       "const": -1
      },
      {
       "$ref": "#/$defs/text"
      }
     ],
     "items": false
    },
    {
     "type": "array",
     "minItems": 2,
     "maxItems": 3,
     "prefixItems": [
      {
       "const": "resource medium"
      },
      {
       "const": -2
      },
      {
       "$ref": "#/$defs/text"
      }
     ],
     "items": false
    },
    {
     "type": "array",
     "minItems": 2,
     "maxItems": 3,
     "prefixItems": [
      {
       "const": "resource large"
      },
      {
       "const": -3
      },
      {
       "$ref": "#/$defs/text"
      }
     ],
     "items": false
    },
    {
     "type": "array",
     "minItems": 2,
     "maxItems": 3,
     "prefixItems": [
      {
       "const": "resource huge"
      },
      {
       "const": -4
      },
      {
       "$ref": "#/$defs/text"
      }
     ],
     "items": false
    },
    {
     "type": "array",
     "minItems": 2,
     "maxItems": 3,
     "prefixItems": [
      {
       "const": "cooldown scene"
      },
      {
       "const": -1
      },
      {
       "$ref": "#/$defs/text"
      }
     ],
     "items": false
    },
    {
     "type": "array",
     "minItems": 2,
     "maxItems": 3,
     "prefixItems": [
      {
       "const": "cooldown day"
      },
      {
       "const": -2
      },
      {
       "$ref": "#/$defs/text"
      }
     ],
     "items": false
    },
    {
     "type": "array",
     "minItems": 2,
     "maxItems": 3,
     "prefixItems": [
      {
       "const": "cast slow"
      },
      {
       "const": -1
      },
      {
       "$ref": "#/$defs/text"
      }
     ],
     "items": false
    },
    {
     "type": "array",
     "minItems": 2,
     "maxItems": 3,
     "prefixItems": [
      {
       "const": "cast long"
      },
      {
       "const": -2
      },
      {
       "$ref": "#/$defs/text"
      }
     ],
     "items": false
    },
    {
     "type": "array",
     "minItems": 2,
     "maxItems": 3,
     "prefixItems": [
      {
       "const": "cast ritual"
      },
      {
       "const": -3
      },
      {
       "$ref": "#/$defs/text"
      }
     ],
     "items": false
    },
    {
     "type": "array",
     "minItems": 2,
     "maxItems": 3,
     "prefixItems": [
      {
       "const": "rare component"
      },
      {
       "const": -1
      },
      {
       "$ref": "#/$defs/text"
      }
     ],
     "items": false
    },
    {
     "type": "array",
     "minItems": 2,
     "maxItems": 3,
     "prefixItems": [
      {
       "const": "tell"
      },
      {
       "const": -1
      },
      {
       "$ref": "#/$defs/text"
      }
     ],
     "items": false
    },
    {
     "type": "array",
     "minItems": 2,
     "maxItems": 3,
     "prefixItems": [
      {
       "const": "backlash mild"
      },
      {
       "const": -1
      },
      {
       "$ref": "#/$defs/text"
      }
     ],
     "items": false
    },
    {
     "type": "array",
     "minItems": 2,
     "maxItems": 3,
     "prefixItems": [
      {
       "const": "backlash harsh"
      },
      {
       "const": -2
      },
      {
       "$ref": "#/$defs/text"
      }
     ],
     "items": false
    },
    {
     "type": "array",
     "minItems": 2,
     "maxItems": 3,
     "prefixItems": [
      {
       "const": "narrow use"
      },
      {
       "const": -1
      },
      {
       "$ref": "#/$defs/text"
      }
     ],
     "items": false
    }
   ]
  },
  "price_breakdown": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "blocks",
    "modifiers",
    "gross",
    "credits",
    "credits_total",
    "net",
    "gp_used",
    "gp_allowed"
   ],
   "properties": {
    "blocks": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/price_pair"
     }
    },
    "modifiers": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/price_pair"
     }
    },
    "gross": {
     "type": "integer"
    },
    "credits": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/credit_pair"
     }
    },
    "credits_total": {
     "type": "integer",
     "minimum": -6,
     "maximum": 0
    },
    "net": {
     "type": "integer"
    },
    "gp_used": {
     "type": "integer",
     "minimum": 0
    },
    "gp_allowed": {
     "type": "integer",
     "minimum": 1,
     "maximum": 7
    }
   }
  },
  "range_field": {
   "anyOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "word",
      "engine"
     ],
     "properties": {
      "word": {
       "$ref": "#/$defs/writer_text"
      },
      "engine": {
       "enum": [
        0,
        1,
        2,
        3,
        4,
        5
       ]
      }
     }
    },
    {
     "$ref": "#/$defs/na"
    }
   ]
  },
  "area_field": {
   "anyOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "word",
      "engine"
     ],
     "properties": {
      "word": {
       "$ref": "#/$defs/writer_text"
      },
      "engine": {
       "enum": [
        0,
        1,
        2,
        3
       ]
      }
     }
    },
    {
     "$ref": "#/$defs/na"
    }
   ]
  },
  "targets_field": {
   "anyOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "word",
      "engine"
     ],
     "properties": {
      "word": {
       "$ref": "#/$defs/writer_text"
      },
      "engine": {
       "type": "integer",
       "minimum": -1,
       "maximum": 5
      }
     }
    },
    {
     "$ref": "#/$defs/na"
    }
   ]
  },
  "duration_field": {
   "anyOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "word",
      "engine"
     ],
     "properties": {
      "word": {
       "$ref": "#/$defs/writer_text"
      },
      "engine": {
       "enum": [
        0,
        1,
        2,
        3,
        4
       ]
      }
     }
    },
    {
     "$ref": "#/$defs/na"
    }
   ]
  },
  "use_time_field": {
   "anyOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "word",
      "engine"
     ],
     "properties": {
      "word": {
       "$ref": "#/$defs/writer_text"
      },
      "engine": {
       "enum": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
       ]
      }
     }
    },
    {
     "$ref": "#/$defs/na"
    }
   ]
  },
  "cooldown_field": {
   "anyOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "word",
      "engine"
     ],
     "properties": {
      "word": {
       "$ref": "#/$defs/writer_text"
      },
      "engine": {
       "enum": [
        0,
        1,
        2
       ]
      }
     }
    },
    {
     "$ref": "#/$defs/na"
    }
   ]
  },
  "resource_field": {
   "anyOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "word",
      "engine"
     ],
     "properties": {
      "word": {
       "$ref": "#/$defs/writer_text"
      },
      "engine": {
       "enum": [
        0,
        1,
        2,
        3,
        4
       ]
      }
     }
    },
    {
     "$ref": "#/$defs/na"
    }
   ]
  },
  "tell_field": {
   "anyOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "word",
      "engine"
     ],
     "properties": {
      "word": {
       "$ref": "#/$defs/writer_text"
      },
      "engine": {
       "enum": [
        0,
        1,
        2,
        3
       ]
      }
     }
    },
    {
     "$ref": "#/$defs/na"
    }
   ]
  },
  "style_value": {
   "anyOf": [
    {
     "$ref": "#/$defs/na"
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "gain",
      "grow"
     ],
     "properties": {
      "gain": {
       "$ref": "#/$defs/text"
      },
      "grow": {
       "$ref": "#/$defs/text"
      }
     }
    }
   ]
  },
  "growth_styles": {
   "type": "object",
   "required": [
    "creation_choice",
    "point_buy",
    "proficiency_ranks",
    "class_level_up_capstones",
    "use_with_caps",
    "perk_trees",
    "free_stat_points",
    "granted_rewards",
    "job_system_cross_equip",
    "class_evolution_consolidation",
    "cultivation_realms",
    "core_stages",
    "essence_combinations",
    "aspect_flaw_soul_rank",
    "dao_comprehension",
    "monster_race_evolution",
    "rarity_grades",
    "fusion_merging",
    "modular_sockets_supports",
    "specialisation_branches",
    "practice_no_screen",
    "learning_rate_marks",
    "binding_vows",
    "sponsor_gifts",
    "discovery_from_play"
   ],
   "propertyNames": {
    "enum": [
     "creation_choice",
     "point_buy",
     "proficiency_ranks",
     "class_level_up_capstones",
     "use_with_caps",
     "perk_trees",
     "free_stat_points",
     "granted_rewards",
     "job_system_cross_equip",
     "class_evolution_consolidation",
     "cultivation_realms",
     "core_stages",
     "essence_combinations",
     "aspect_flaw_soul_rank",
     "dao_comprehension",
     "monster_race_evolution",
     "rarity_grades",
     "fusion_merging",
     "modular_sockets_supports",
     "specialisation_branches",
     "practice_no_screen",
     "learning_rate_marks",
     "binding_vows",
     "sponsor_gifts",
     "discovery_from_play"
    ]
   },
   "additionalProperties": {
    "$ref": "#/$defs/style_value"
   }
  },
  "identity": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "name",
    "other_names",
    "kind",
    "branch",
    "family",
    "sub_family",
    "description_easy",
    "tags"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
     "$ref": "#/$defs/text"
    },
    "other_names": {
     "$ref": "#/$defs/text_list"
    },
    "kind": {
     "enum": [
      "skill",
      "spell",
      "technique",
      "power",
      "trait",
      "perk_or_feat",
      "title",
      "class_feature",
      "system_function",
      "flaw",
      "condition",
      "resource"
     ]
    },
    "branch": {
     "enum": [
      "A",
      "B",
      "C",
      "D",
      "E",
      "F",
      "G",
      "H"
     ]
    },
    "family": {
     "$ref": "#/$defs/text"
    },
    "sub_family": {
     "$ref": "#/$defs/text"
    },
    "description_easy": {
     "$ref": "#/$defs/writer_text"
    },
    "tags": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "element",
      "damage_type",
      "approach",
      "school",
      "tradition"
     ],
     "properties": {
      "element": {
       "anyOf": [
        {
         "type": "array",
         "minItems": 1,
         "uniqueItems": true,
         "items": {
          "$ref": "#/$defs/element_name"
         }
        },
        {
         "$ref": "#/$defs/na"
        }
       ]
      },
      "damage_type": {
       "anyOf": [
        {
         "type": "array",
         "minItems": 1,
         "uniqueItems": true,
         "items": {
          "$ref": "#/$defs/damage_name"
         }
        },
        {
         "$ref": "#/$defs/na"
        }
       ]
      },
      "approach": {
       "anyOf": [
        {
         "type": "array",
         "minItems": 1,
         "uniqueItems": true,
         "items": {
          "$ref": "#/$defs/approach_name"
         }
        },
        {
         "$ref": "#/$defs/na"
        }
       ]
      },
      "school": {
       "$ref": "#/$defs/text_list_or_na"
      },
      "tradition": {
       "$ref": "#/$defs/text_list_or_na"
      }
     }
    }
   }
  },
  "balance": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "price_class",
    "tier",
    "band",
    "price_breakdown",
    "strong_against",
    "weak_against",
    "stacking_limits"
   ],
   "properties": {
    "price_class": {
     "enum": [
      "active",
      "passive",
      "title",
      "flaw",
      "pool",
      "condition"
     ]
    },
    "tier": {
     "type": "integer",
     "minimum": 1,
     "maximum": 7,
     "description": "Declared by the author. Never read back from the price."
    },
    "band": {
     "type": "array",
     "minItems": 2,
     "maxItems": 2,
     "items": {
      "type": "integer"
     }
    },
    "price_breakdown": {
     "$ref": "#/$defs/price_breakdown"
    },
    "strong_against": {
     "$ref": "#/$defs/text_list_or_na"
    },
    "weak_against": {
     "$ref": "#/$defs/text_list_or_na"
    },
    "stacking_limits": {
     "$ref": "#/$defs/text"
    }
   },
   "allOf": [
    {
     "if": {
      "required": [
       "tier",
       "price_class"
      ],
      "properties": {
       "tier": {
        "const": 1
       },
       "price_class": {
        "enum": [
         "active",
         "passive",
         "title",
         "pool",
         "condition"
        ]
       }
      }
     },
     "then": {
      "properties": {
       "band": {
        "const": [
         3,
         6
        ]
       },
       "price_breakdown": {
        "properties": {
         "net": {
          "minimum": 3,
          "maximum": 6
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "required": [
       "tier",
       "price_class"
      ],
      "properties": {
       "tier": {
        "const": 2
       },
       "price_class": {
        "enum": [
         "active",
         "passive",
